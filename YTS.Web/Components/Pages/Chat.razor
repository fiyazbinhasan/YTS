@page "/"
@using Microsoft.Extensions.AI
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>AI Chat demo</h1>

<fieldset>
    <legend>Model</legend>
    <InputRadioGroup @bind-Value="_selectedClient">
        <div>
            <label>
                <InputRadio Value="@ServiceKeys.Deepseek" />
                @_modelNames[ServiceKeys.Deepseek]
            </label>
        </div>
        <div>
            <label>
                <InputRadio Value="@ServiceKeys.Llama" />
                @_modelNames[ServiceKeys.Llama]
            </label>
        </div>
    </InputRadioGroup>
</fieldset>

<p><input type="text" @bind-value="_prompt" />&nbsp;<button @onclick="GetPrompt">Ask</button></p>
<p>@_response</p>

@code {
    private string _prompt = "";
    private string _response = "";

    [Inject(Key = ServiceKeys.Deepseek)]
    public required IChatClient Deepseek { get; set; }

    [Inject(Key = ServiceKeys.Llama)]
    public required IChatClient Llama { get; set; }

    private readonly Dictionary<string, string> _modelNames = new()
    {
        { ServiceKeys.Deepseek, "deepseek" },
        { ServiceKeys.Llama, "llama" },
    };

    private string _selectedClient = ServiceKeys.Deepseek;

    private async Task GetPrompt()
    {
        var client = _selectedClient switch
        {
            ServiceKeys.Deepseek => Deepseek,
            ServiceKeys.Llama => Llama,
            _ => null
        };

        if (!string.IsNullOrWhiteSpace(_prompt))
        {
            if (client is null)
            {
                _response = "No model selected";
                return;
            }

            bool gotResponse = false;
            _response = "Asking Ollama...";

            var stream = client.CompleteStreamingAsync(_prompt);

            await foreach (var answerToken in stream)
            {
                if (!gotResponse)
                {
                    _response = "";
                    gotResponse = true;
                }

                _response += answerToken.Text;
                StateHasChanged();
            }
        }
    }
}