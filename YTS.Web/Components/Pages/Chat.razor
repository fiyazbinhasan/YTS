@page "/"
@using Microsoft.Extensions.AI
@using OllamaSharp.ModelContextProtocol
@using OllamaSharp.ModelContextProtocol.Server
@rendermode InteractiveServer

<PageTitle>Chat</PageTitle>

<h1>MCP Chat Demo</h1>

<p><input type="text" @bind-value="_prompt" />&nbsp;<button @onclick="GetPrompt">Ask</button></p>
<p>@_response</p>

@code {
    private string _prompt = "";
    private string _response = "";

    [Inject(Key = ServiceKeys.Mistral)]
    public required IChatClient Mistral { get; set; }

    private async Task GetPrompt()
    {
        if (!string.IsNullOrWhiteSpace(_prompt))
        {
            bool gotResponse = false;
            _response = "Asking Ollama...";

            var serverConfig = new McpServerConfiguration
            {
                Name = "Ollama Math MCP Server",
                Command = "http://localhost:5062/sse",
                TransportType = McpServerTransportType.Sse
            };

            var mcpTools = await Tools.GetFromMcpServers(serverConfig);

            var tools = mcpTools.Cast<McpClientTool>()
                .Select(AITool (t) => new McpFunctionAdapter(t))
                .ToList();

            var stream = Mistral.GetStreamingResponseAsync(_prompt, new ChatOptions
            {
                Tools = [..tools]
            });

            await foreach (var answerToken in stream)
            {
                if (!gotResponse)
                {
                    _response = "";
                    gotResponse = true;
                }

                _response += answerToken.Text;
                StateHasChanged();
            }
        }
    }
}